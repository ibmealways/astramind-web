# Server
NODE_ENV=development
BACKEND_PORT=5000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_TOKEN_USER_FALLBACK=false
INTERNAL_API_URL=http://127.0.0.1:5000

# Persistent database paths
AIGENIKZ_AUTH_DB_PATH=./data/aigenikz-auth.db
AIGENIKZ_PLATFORM_DB_PATH=./data/aigenikz-platform.db

# Intelligence providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=
LICENSED_MUSIC_URL=
LICENSED_MUSIC_LICENSE=
OBJECT_STORAGE_UPLOAD_URL=
CDN_PUBLIC_URL_TEMPLATE=
RUNWAYML_API_SECRET=
VIDEO_PROVIDER_COST_PER_SECOND_USD=0.12
VIDEO_MAX_PROVIDER_COST_USD=8
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=false
AIGENIKZ_VIDEO_MODE=local-test

# Stripe staging/test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
