# AstraMind self-hosted video generation
AI_VIDEO_PROVIDER=astramind-native
ASTRAMIND_NATIVE_VIDEO_URL=http://127.0.0.1:8189
ASTRAMIND_NATIVE_VIDEO_TOKEN=replace-with-a-long-random-secret
ASTRAMIND_NATIVE_VIDEO_BACKEND=ltx
ASTRAMIND_NATIVE_VIDEO_MODEL=Lightricks/LTX-Video
ASTRAMIND_NATIVE_VIDEO_TIMEOUT_MS=1200000
ASTRAMIND_NATIVE_VIDEO_POLL_MS=3000

# Paid motion providers are disabled unless explicitly enabled.
ASTRAMIND_ALLOW_PAID_VIDEO_PROVIDERS=false
