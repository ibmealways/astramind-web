# Server
NODE_ENV=development
BACKEND_PORT=5000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_URL=http://127.0.0.1:5000

# Persistent database paths
AIGENIKZ_AUTH_DB_PATH=./data/aigenikz-auth.db
AIGENIKZ_PLATFORM_DB_PATH=./data/aigenikz-platform.db

# Intelligence providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=false
AI_VIDEO_PROVIDER=local

# Stripe staging/test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=